pragma solidity ^0.8.20;

// ZK Labeled Signer + Scope Proof Verifier
// ERC-8039 adapter for the `zk_labeled_signer_scope` Noir circuit.
//
// The circuit proves atomically:
//   1. An authorized signer (identity hidden) signed the transaction.
//   2. The call destination, together with a private label and a scope rule
//      (or a wildcard sentinel for "no restriction"), forms a single leaf in
//      the account's unified scope tree. See docs/zk-labeled-signer-scope.md.
//
// Developed by Microchain Labs

import { IERC8039, ProofTypes, ERC8039Constants } from "./IERC8039.sol";
import { IERC165 } from "@openzeppelin/contracts/interfaces/IERC165.sol";

// This import resolves to the Solidity verifier generated by:
//   nargo compile   (inside zk-smart-account-kit/noir, package zk_labeled_signer_scope)
//   bb write_vk && bb write_solidity_verifier   (barretenberg UltraHonk back-end)
//
// The generated file is copied to this path as part of the build pipeline.
// Until the circuit is compiled and the verifier is generated, this import will
// not resolve — swap `HonkVerifier` for an interface / mock in tests until then,
// same as the other not-yet-generated ERC-8039 verifiers in this directory.
import { HonkVerifier } from "../../noir/target/zk_labeled_signer_scope.sol";

/// @title ZKLabeledSignerScopeProofVerifier
/// @notice ERC-8039 adapter that wraps the barretenberg UltraHonk verifier
///         generated for the `zk_labeled_signer_scope` Noir circuit.
///
/// @dev Public inputs layout (41 × bytes32), matches the circuit's `pub`
///      parameters exactly (see circuits/zk_labeled_signer_scope/src/main.nr
///      in zk-smart-account-kit and docs/zk-labeled-signer-scope.md):
///   [0..31]  txn_hash bytes  (userOpHash decomposed into 32 individual byte-fields)
///   [32]     signersRoot
///   [33]     destAddressField
///   [34]     txnSelector      (occupies the low 32 bits of the field)
///   [35]     txnValue         (wei)
///   [36..39] txnParams        (4 decoded calldata parameters, extracted on-chain
///            from the real calldata — see ZKLabeledSignerScopeValidator.sol)
///   [40]     scopeRoot
///
/// @author Microchain Labs
contract ZKLabeledSignerScopeProofVerifier is IERC8039, IERC165 {
    /// @notice The underlying UltraHonk verifier generated by barretenberg
    HonkVerifier public immutable honkVerifier;

    /// @notice Expected number of public inputs for this circuit
    uint256 public constant PUBLIC_INPUTS_COUNT = 41;

    error InvalidPublicInputsLength(uint256 got, uint256 expected);

    constructor(address _honkVerifier) {
        require(_honkVerifier != address(0), "ZKLabeledSignerScopeProofVerifier: zero address");
        honkVerifier = HonkVerifier(_honkVerifier);
    }

    /// @inheritdoc IERC8039
    function verifyProof(
        bytes calldata publicInputs,
        bytes calldata proof
    ) external view override returns (bytes4 magicValue) {
        bytes32[] memory decoded = abi.decode(publicInputs, (bytes32[]));

        if (decoded.length != PUBLIC_INPUTS_COUNT) {
            revert InvalidPublicInputsLength(decoded.length, PUBLIC_INPUTS_COUNT);
        }

        bool valid = honkVerifier.verify(proof, decoded);
        if (valid) magicValue = ERC8039Constants.PROOF_MAGIC_VALUE;
    }

    /// @inheritdoc IERC8039
    function getProofType() external pure override returns (bytes32) {
        return ProofTypes.HONK_BARRETENBERG;
    }

    /// @inheritdoc IERC8039
    function metadata() external pure override returns (string memory) {
        return "ZK Labeled Signer + Scope v0.1.0 - Proves authorized signer + unified scope-rule membership";
    }

    /// @notice ERC-165 introspection
    function supportsInterface(bytes4 interfaceId) external pure override returns (bool) {
        return
            interfaceId == type(IERC8039).interfaceId ||
            interfaceId == type(IERC165).interfaceId;
    }
}
